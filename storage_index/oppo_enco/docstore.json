f9-764ef0bf4cb9"}, "5310904e-a944-41f7-bbc8-0517e7f29d80": {"doc_hash": "76032b9371ca1e66ba6b6ef5a5c179e3ca00765dcf201862eaee72df61c3c4b7", "ref_doc_id": "13aca537-2c02-4c5d-98bd-e6a5fcc763b8"}}, "docstore/data": {"185e65ea-8e1f-46df-8d60-6873786a16a1": {"__data__": {"id_": "185e65ea-8e1f-46df-8d60-6873786a16a1", "embedding": null, "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "b4438aa1-aeb5-4a02-ba3b-7f7aad13335e", "node_type": "4", "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "hash": "48e5a5d06d99f1b9f1389778accf3ece99f17f293ff417b0bb97379988e4abc0", "class_name": "RelatedNodeInfo"}}, "text": "OPPO Enco Air4 Pro, Lengkap Pelbagai Ciri Premium Dengan Harga Marhaen\n---", "start_char_idx": 2, "end_char_idx": 76, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, "7ef5de0b-c3c9-4d14-8d26-548711fd4ce5": {"__data__": {"id_": "7ef5de0b-c3c9-4d14-8d26-548711fd4ce5", "embedding": null, "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "1c2ab42f-ed8e-46a2-8858-d1c0eda6e750", "node_type": "4", "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "hash": "aa3e3189b5d84116bde576ca5b7f4e406dcab4e313faa7a29970a584adaa3635", "class_name": "RelatedNodeInfo"}}, "text": "501 TEKNOLOGI\n\n\nDi dalam kesibukan seharian, anda pasti mahukan satu \u201cruangan\u201d yang bebas dari segala suara bingit atau pencemaran bunyi yang terhasil di sekeliling kita.\n\nOleh itu, OPPO sedia memberi solusi terbaik buat anda dengan pengenalan Enco Air4 Pro terbaharu mereka yang bakal menjanjikan pengalaman noise cancelling yang luar biasa beserta kemampuan audio yang hebat pada harga mampu milik.\n---", "start_char_idx": 2, "end_char_idx": 406, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, "f7ed8ebc-4d21-48ef-bf01-f26970cebde2": {"__data__": {"id_": "f7ed8ebc-4d21-48ef-bf01-f26970cebde2", "embedding": null, "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "f85bc760-cf4e-4e31-8770-07c2fc78ef9f", "node_type": "4", "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "hash": "0cb16af3e1442e1ebb03351b6ae176758e5512a216933241f1b3f675ce4a395c", "class_name": "RelatedNodeInfo"}}, "text": "Review Enco Air4 Pro\n\n\nKami diberikan sebuah unit untuk merasai sendiri pengalaman menggunakan Enco Air4 Pro di dalam dunia sebenar selama dua minggu. Boleh teruskan bacaan untuk mengetahui lanjut berkaitan produk Enco Air4 Pro.\n\nRekaan ergonomik\n\nDari segi rekaan luaran, Enco Air4 Pro menampilkan pod pengecas berbentuk kapsul yang cukup sleek dan kompak sekaligus mudah untuk dipegang atau disimpan pada beg atau poket. Ditambah pula dengan tekstur unik membuatkan ia tampak premium dalam masa yang sama kalis cap jari.\n---", "start_char_idx": 2, "end_char_idx": 528, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, "64f80f96-36cd-4ad0-834c-4e1e16505fbd": {"__data__": {"id_": "64f80f96-36cd-4ad0-834c-4e1e16505fbd", "embedding": null, "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "01fc0d2c-66e0-45fd-a869-7959fb50e0e1", "node_type": "4", "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "hash": "64afcc097e586dfd9beae3cccb63fe433fcd40d7a78f757fa37a059a0503ee94", "class_name": "RelatedNodeInfo"}}, "text": "Sementara fon telinganya, ia juga direka dengan menekankan aspek ergonomik kerana terletak rapi pada telinga sebaik dipakai. Selain selesa dipakai, anda juga boleh menggunakannya sepanjang hari kerana sangat ringan dan boleh menukar putik getah mengikut keselesaan saiz telinga masing-masing.\n---\n\n---", "start_char_idx": 2, "end_char_idx": 303, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, "d9053699-d290-4bf5-a748-19ae09a3bf4f": {"__data__": {"id_": "d9053699-d290-4bf5-a748-19ae09a3bf4f", "embedding": null, "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "2de77830-e3cb-4963-9bd0-a5209c71f815", "node_type": "4", "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "hash": "12292a914fd6a6cbe6543c831eeb46bbccfd6e676a699f0aff792396d39bf4a8", "class_name": "RelatedNodeInfo"}}, "text": "Review Enco Air4 Pro\n\n\nSetakat penggunaan selama dua minggu ini, kami mendapati prestasi yang ditampilkan oleh Enco Air4 Pro memang cemerlang terutamanya dalam menawarkan kualiti audio yang baik serta kemampuan tambatan yang sangat pantas.\n\nSaat anda membuka penutup pod pengecasnya, fon telinga ini terus menambat pada peranti yang dimahukan dan boleh memainkan sebarang audio yang sedang dipasang.\n\nBercakap berkenaan kualiti audio, fon telinga ini mampu memberikan kualiti audio yang baik dan cukup memuaskan hati sepanjang tempoh penggunaan.\n\nMenariknya, anda boleh mendengar segala audio dengan jelas dan baik walaupun pada tahap kelantangan yang minima. Hal ini kerana adanya teknologi audio Hi-Res LHDX 5.0 serta pemandu audio yang lebih besar 12.mm sekaligus menjanjikan pengalaman audio yang cukup mengagumkan.\n\nFungsi In-ear Detection juga tersedia membolehkan muzik berhenti secara automatik sebaik sahaja fon telinga ditanggalkan. Selepas fon telinga dipasang semula pada telinga, maka muzik akan dimainkan kembali.\n\nFon telinga OPPO terbaharu ini menggunakan sistem tri-mikrofon untuk membatalkan bunyi hingar dan meningkatkan kejelasan, sekaligus berupaya menjawab panggilan dengan kualiti audio yang luar biasa.\n\nSemuanya di hujung jari\n---", "start_char_idx": 2, "end_char_idx": 1257, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, "ad1f1e5c-8c64-4a75-b8a6-607f708845b6": {"__data__": {"id_": "ad1f1e5c-8c64-4a75-b8a6-607f708845b6", "embedding": null, "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "d1b6e5c8-0049-49c0-b25c-a5a6ed5cfad7", "node_type": "4", "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "hash": "3a254392dc601cb3e0aa315ea5b13d5b6d7202fd7f830b2097a0f7afcb981607", "class_name": "RelatedNodeInfo"}}, "text": "Oppo: Fokus pada Kemudahan Pengguna\n\n\nOppo terbukti sangat menitikberatkan di dalam aspek mesra pengguna pada fon telinga kali ini di mana pelbagai fungsi boleh diakses pada hujung jari sahaja. Ini termasuklah mampu menukar dan menghentikan lagu, beralih kepada mod ANC atau transparency dengan hanya kawalan sesentuh pada tangkai fon telinga.\n---\n\n---", "start_char_idx": 2, "end_char_idx": 354, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, "2efb4321-e0da-465f-8a77-25a961950e41": {"__data__": {"id_": "2efb4321-e0da-465f-8a77-25a961950e41", "embedding": null, "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "988d056e-d078-4273-9021-13b201bef784", "node_type": "4", "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "hash": "00c1533a3297e010be20931ce2f92c03de3437d97205b69c0f10fe8ed7693b68", "class_name": "RelatedNodeInfo"}}, "text": "OPPO HeyMelody Application Features\n\n\nUntuk melengkapkan lagi kemudahan buat pengguna, OPPO turut hadir dengan aplikasi tersendiri iaitu HeyMelody yang memudahkan kita menyemak kadar bateri kes dan fon telinga, menukar beberapa mod audio, tahap pembatalan hingar dan juga penjejak fon telinga jika hilang.\n\nCiri ANC yang mantap\n---", "start_char_idx": 2, "end_char_idx": 333, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, "d5549ecb-2c6e-4b7b-9b20-42ea40745549": {"__data__": {"id_": "d5549ecb-2c6e-4b7b-9b20-42ea40745549", "embedding": null, "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "8fd30122-3ed9-4e55-97a9-5edc284ed57e", "node_type": "4", "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "hash": "55d636a08693766cec8f13697bfefe355c7d04428fe4e17e9b3127de9f78445b", "class_name": "RelatedNodeInfo"}}, "text": "Sebaik mengenakan fon telinga\n\n\nKami dapati bunyi dari luar berjaya dihalang dengan efektif kerana sistem kedap bunyi yang baik ditampilkan.\n\nUntuk mendapatkan pembatalan hinggar yang sempurna, anda hanya perlu mengaktifkan mod ANC dengan tekan pada tangkai fon telinga selama dua saat. Segala pencemaran dari luar akan dibatalkan dengan baik di mana sangat membantu dalam memberi fokus pada tugasan yang sedang dilakukan.\n---", "start_char_idx": 2, "end_char_idx": 428, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, "7146fb06-0173-4258-8599-c2be5d19b2b8": {"__data__": {"id_": "7146fb06-0173-4258-8599-c2be5d19b2b8", "embedding": null, "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "b8e7a759-9a84-46e0-878b-660b1c36180f", "node_type": "4", "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "hash": "0cfc5d210f943439c3870ef7e4a52269e454b95ad37b73b6abf551d370649bb5", "class_name": "RelatedNodeInfo"}}, "text": "Review: OPPO Enco Air4 Pro\n\n\nKami sudah mencuba sendiri di beberapa kawasan terbuka seperti di stesen LRT dan pusat beli-belah dan fon telinga ini boleh menghalang 90% bunyi hingar yang terhasil dari persekitaran.\n\nSistem ANC yang terbina pada OPPO Enco Air4 Pro ini berupaya membatalkan hingar sehingga 49dB dengan tiga tahap pilihan iaitu Mild, Moderate dan Max yang boleh ditetapkan menerusi aplikasi.\n\nJangka hayat bateri bertahan sepanjang hari\n---", "start_char_idx": 2, "end_char_idx": 455, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, "e0550c76-395b-43a5-9cf4-a5d0aa03bf18": {"__data__": {"id_": "e0550c76-395b-43a5-9cf4-a5d0aa03bf18", "embedding": null, "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "94bc4f64-769c-4387-83af-bb0794fc7f56", "node_type": "4", "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "hash": "a556e930e862a30208c530fd883b517441c8f5be87172d15f2e2942f7b0c062b", "class_name": "RelatedNodeInfo"}}, "text": "Review: Enco Air4 Pro Battery Endurance\n\n\nDari segi ketahanan bateri pula, Enco Air4 Pro terbukti mampu beroperasi lebih 12 jam tanpa ANC dan lebih 5 jam dengan mengaktifkan ciri ANC menerusinya.\n\nSepanjang penggunaan, kami boleh kira dengan jari hanya beberapa kali sahaja mengecas fon telinga lebih-lebih lagi jika tidak menggunakan ciri ANC. Jikalau mengaktifkan ANC pun, kami tetap berpuas hati dengan prestasinya boleh bertahan sepanjang pagi hari sewaktu bertugas.\n---", "start_char_idx": 2, "end_char_idx": 476, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, "1439d0c1-b23b-4b4e-9dba-91330d6a0861": {"__data__": {"id_": "1439d0c1-b23b-4b4e-9dba-91330d6a0861", "embedding": null, "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "c4a07402-b6cb-48c0-ac97-168f20c47a4b", "node_type": "4", "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "hash": "4a8b76575a9df7e2bc8a7cdf0a06fe8694052fa603731b70de35f85cf3f82586", "class_name": "RelatedNodeInfo"}}, "text": "Review Enco Air4 Pro: Kelebihan dan Kelemahan\n\n\nMeskipun tampak sempurna, masih ada kelemahan yang kami dapati pada Enco Air4 Pro ini seperti ketiadaan ciri melaras tahap kelantangan audio pada tangkai fon telinga. Jadi, anda perlu secara manual merendahkan atau menaikkan kelantangan audio menerusi telefon pintar masing-masing.\n\nBerbaloi ke beli?\n\nPada hemat kami, Enco Air4 Pro berjaya membuktikan kemampuannya dari segi prestasi seharian mahupun binaan keseluruhan yang mantap. Kami percaya fon telingar ini cukup berbaloi untuk didapatkan buat anda yang mahu menikmati segala ciri premium pada harga marhaen.\n\nAnda boleh dapatkan Enco Air4 Pro ini dengan harga RM399 dengan dua pilihan warna iaitu Midnight Black dan Moonlight White menerusi laman rasmi OPPO.\n---", "start_char_idx": 2, "end_char_idx": 770, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, "5786ab56-2ea9-4ade-a5b5-b2e38093d703": {"__data__": {"id_": "5786ab56-2ea9-4ade-a5b5-b2e38093d703", "embedding": null, "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "bf74d4ae-0ec8-483c-a4d9-684d556c9375", "node_type": "4", "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "hash": "cbd66dad5e0f1315ddbcebdcf1df95ced7eba81b6be79b11d278873e6779757f", "class_name": "RelatedNodeInfo"}}, "text": "OPPO Pad Neo, Tablet Serba Boleh Dengan Harga Mampu Milik\n\nOPPO Pad Neo, Tablet Serba Boleh Dengan Harga Mampu Milik\n\nOLEH HIZAM JAAFAR\n---", "start_char_idx": 2, "end_char_idx": 141, "text_template": "{metadata_str}\n\n{content}", "metadata_template": "{key}: {value}", "metadata_seperator": "\n", "class_name": "TextNode"}, "__type__": "1"}, "54dd2623-19c5-491b-a75b-f7111e9e7466": {"__data__": {"id_": "54dd2623-19c5-491b-a75b-f7111e9e7466", "embedding": null, "metadata": {"file_path": "storage_parse/oppo_enco.md", "file_name": "oppo_enco.md", "file_size": 5977, "creation_date": "2024-08-05", "last_modified_date": "2024-08-05"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accesse