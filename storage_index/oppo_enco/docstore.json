{"docstore/metadata": {"b4438aa1-aeb5-4a02-ba3b-7f7aad13335e": {"doc_hash": "48e5a5d06d99f1b9f1389778accf3ece99f17f293ff417b0bb97379988e4abc0"}, "1c2ab42f-ed8e-46a2-8858-d1c0eda6e750": {"doc_hash": "aa3e3189b5d84116bde576ca5b7f4e406dcab4e313faa7a29970a584adaa3635"}, "f85bc760-cf4e-4e31-8770-07c2fc78ef9f": {"doc_hash": "0cb16af3e1442e1ebb03351b6ae176758e5512a216933241f1b3f675ce4a395c"}, "01fc0d2c-66e0-45fd-a869-7959fb50e0e1": {"doc_hash": "64afcc097e586dfd9beae3cccb63fe433fcd40d7a78f757fa37a059a0503ee94"}, "2de77830-e3cb-4963-9bd0-a5209c71f815": {"doc_hash": "12292a914fd6a6cbe6543c831eeb46bbccfd6e676a699f0aff792396d39bf4a8"}, "d1b6e5c8-0049-49c0-b25c-a5a6ed5cfad7": {"doc_hash": "3a254392dc601cb3e0aa315ea5b13d5b6d7202fd7f830b2097a0f7afcb981607"}, "988d056e-d078-4273-9021-13b201bef784": {"doc_hash": "00c1533a3297e010be20931ce2f92c03de3437d97205b69c0f10fe8ed7693b68"}, "8fd30122-3ed9-4e55-97a9-5edc284ed57e": {"doc_hash": "55d636a08693766cec8f13697bfefe355c7d04428fe4e17e9b3127de9f78445b"}, "b8e7a759-9a84-46e0-878b-660b1c36180f": {"doc_hash": "0cfc5d210f943439c3870ef7e4a52269e454b95ad37b73b6abf551d370649bb5"}, "94bc4f64-769c-4387-83af-bb0794fc7f56": {"doc_hash": "a556e930e862a30208c530fd883b517441c8f5be87172d15f2e2942f7b0c062b"}, "c4a07402-b6cb-48c0-ac97-168f20c47a4b": {"doc_hash": "4a8b76575a9df7e2bc8a7cdf0a06fe8694052fa603731b70de35f85cf3f82586"}, "bf74d4ae-0ec8-483c-a4d9-684d556c9375": {"doc_hash": "cbd66dad5e0f1315ddbcebdcf1df95ced7eba81b6be79b11d278873e6779757f"}, "d838ce00-8fa3-47b0-83f9-764ef0bf4cb9": {"doc_hash": "f103ab68463824773d8476613d17aba6379c55bfa9e0b216a49a7f7b0cf4d61a"}, "13aca537-2c02-4c5d-98bd-e6a5fcc763b8": {"doc_hash": "4aa4918458cb1128a715da4f3b0a11d25908ffb63e2be2f61c79770aca102798"}, "185e65ea-8e1f-46df-8d60-6873786a16a1": {"doc_hash": "fb054d2710fbe79b8d50d3df8efabc7cf95cc691020ca88b362c461fd151eae2", "ref_doc_id": "b4438aa1-aeb5-4a02-ba3b-7f7aad13335e"}, "7ef5de0b-c3c9-4d14-8d26-548711fd4ce5": {"doc_hash": "c3417be9192c6c83862e235e895da73cba63cf1